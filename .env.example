# Copy to .env.local. Never commit keys or paste secrets into chat.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Auth0 owns Breadcrumb passwords when these are set (server only). Leave blank for Supabase email sign-up.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Optional; defaults to Username-Password-Authentication.
AUTH0_DB_CONNECTION=
# BreadPass "slice the loaf" human check (server only; same value as the Auth0 Action secret).
# Generate with `openssl rand -hex 32`. Blank turns the slice off.
LOAF_SECRET=
NEXT_PUBLIC_MAPBOX_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
# Ask only: prefers Groq when its key is set; ingestion retains Gemini.
GROQ_API_KEY=
# Optional; defaults to openai/gpt-oss-120b (strict JSON schema support required).
GROQ_MODEL=
# Optional override: groq or gemini. Blank selects Groq when configured.
ASK_AI_PROVIDER=
CRON_SECRET=
# Public feed ingestion; enable only after applying the event-ingestion migration.
EVENT_SYNC_ENABLED=0
EVENT_SYNC_SOURCES=gatorconnect,uf-calendar,libraries,arts,gatornights
# Server/CLI only. Instagram is manual; it is never part of scheduled sync.
APIFY_API_TOKEN=
# Optional extraction-specific Gemini model; falls back to GEMINI_MODEL.
GEMINI_EVENT_MODEL=
DEMO_CACHE=0

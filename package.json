{
  "name": "breadcrumb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:mobile": "npm run start --workspace=@breadcrumb/mobile",
    "android": "npm run android --workspace=@breadcrumb/mobile",
    "ios": "npm run ios --workspace=@breadcrumb/mobile",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && npm run lint --workspace=@breadcrumb/mobile",
    "typecheck": "next typegen && tsc --noEmit && npm run typecheck --workspace=@breadcrumb/mobile",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "react-native-gesture-handler": "2.32.0"
  },
  "dependencies": {
    "@breadcrumb/client": "*",
    "@breadcrumb/shared": "*",
    "@google/genai": "^2.30.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "mapbox-gl": "^3.33.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pbf": "^5.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
